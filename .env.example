# Copy this file to .env and paste your real key:
#   cp .env.example .env
#
# Get a key: https://platform.openai.com/api-keys
# Never commit .env to git or publish it.

OPENAI_API_KEY=sk-your-key-here
PORT=3000

# Optional: restrict who can call your API (leave empty to allow all)
# CORS_ORIGIN=https://your-domain.com

# Vision model for frame-based advice (default gpt-4o-mini)
# OPENAI_VISION_MODEL=gpt-4o-mini

# Rate limits (per IP) — protect your OpenAI bill
LIMIT_TRANSCRIBE_PER_HOUR=10
LIMIT_ANALYZE_PER_HOUR=10
LIMIT_ANALYZE_PER_DAY=30


# Stripe (payments → your bank account / card payouts)
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Public site URL for redirects after pay (Render URL later)
PUBLIC_URL=http://localhost:3000

# Instagram live profile (Apify) — optional
# https://console.apify.com/account/integrations
APIFY_TOKEN=
# Default actor (change if needed)
APIFY_IG_ACTOR=apify/instagram-profile-scraper

# 1 = everything free (no coins, no paywall). Set 0 to re-enable paid later.
FREE_MODE=1

# Google Sign-In (optional). Create OAuth Client ID (Web) in Google Cloud Console.
GOOGLE_CLIENT_ID=
# Admin emails (comma-separated) — full admin panel
ADMIN_EMAILS=boburkachok2010@gmail.com
